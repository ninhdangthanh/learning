{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "sns.amazonaws.com" },
      "Action": "sqs:SendMessage",
      "Resource": "PAYMENT_QUEUE_ARN_PLACEHOLDER",
      "Condition": {
        "ArnEquals": { "aws:SourceArn": "TOPIC_ARN_PLACEHOLDER" }
      }
    }
  ]
}